export struct FinderItem {
    name: string,
    is-dir: bool,
    size-str: string,
}

export component FinderWindow inherits Window {
    title: "Finder";
    width: 820px;
    height: 520px;
    background: #1e1e21;
    default-font-family: "SF Pro Text, -apple-system, Helvetica Neue, sans-serif";

    in property <string> current-path-str: "/Users/hassan";
    in property <[FinderItem]> items: [];
    in property <string> status-text: "0 items";

    callback item-clicked(int);
    callback back-clicked();
    callback forward-clicked();
    callback sidebar-clicked(string);
    callback close-window();

    VerticalLayout {
        spacing: 0px;

        // Top Toolbar
        Rectangle {
            height: 42px;
            background: #252528;
            border-width: 1px;
            border-color: #333338;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                // Traffic lights and Nav Chevrons
                HorizontalLayout {
                    spacing: 16px;
                    y: (parent.height - 18px) / 2;

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ff5f57; TouchArea { clicked => { root.close-window(); } } }
                        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #febc2e; }
                        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #28c840; }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 24px;
                            height: 20px;
                            border-radius: 4px;
                            background: back-touch.pressed ? #38383c : #2c2c30;
                            back-touch := TouchArea { clicked => { root.back-clicked(); } }
                            Text { text: "◀"; font-size: 10px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 24px;
                            height: 20px;
                            border-radius: 4px;
                            background: fwd-touch.pressed ? #38383c : #2c2c30;
                            fwd-touch := TouchArea { clicked => { root.forward-clicked(); } }
                            Text { text: "▶"; font-size: 10px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Centered Path Breadcrumb
                Text {
                    text: root.current-path-str;
                    font-size: 12px;
                    font-weight: 600;
                    color: #dddddd;
                    vertical-alignment: center;
                }

                // Search box
                Rectangle {
                    width: 140px;
                    height: 24px;
                    border-radius: 6px;
                    background: #1a1a1c;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text { text: "🔍 Search"; font-size: 11px; color: #77777c; vertical-alignment: center; }
                    }
                }
            }
        }

        // Two-Column Layout
        HorizontalLayout {
            spacing: 0px;

            // Sidebar
            Rectangle {
                width: 180px;
                background: #1a1a1c;
                border-width: 1px;
                border-color: #2c2c30;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;

                    Text { text: "Favorites"; font-size: 11px; font-weight: 600; color: #88888c; }

                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: #2b2b30;
                        TouchArea { clicked => { root.sidebar-clicked("home"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            Text { text: "🏠"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Home"; font-size: 13px; color: #ffffff; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: transparent;
                        TouchArea { clicked => { root.sidebar-clicked("desktop"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            Text { text: "🖥️"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Desktop"; font-size: 13px; color: #cccccc; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: transparent;
                        TouchArea { clicked => { root.sidebar-clicked("documents"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            Text { text: "📄"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Documents"; font-size: 13px; color: #cccccc; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: transparent;
                        TouchArea { clicked => { root.sidebar-clicked("downloads"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            Text { text: "⬇️"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Downloads"; font-size: 13px; color: #cccccc; vertical-alignment: center; }
                        }
                    }
                }
            }

            // File Content Browser
            Rectangle {
                background: #161618;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // Items List
                    for item[idx] in root.items: Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: item-touch.has-hover ? #25252a : transparent;

                        item-touch := TouchArea {
                            clicked => { root.item-clicked(idx); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: item.is-dir ? "📁" : "📄";
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: item.name;
                                    font-size: 13px;
                                    color: item.is-dir ? #007aff : #ffffff;
                                    font-weight: item.is-dir ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: item.size-str;
                                font-size: 12px;
                                color: #88888c;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Status Bar
        Rectangle {
            height: 24px;
            background: #202023;
            border-width: 1px;
            border-color: #2c2c30;

            HorizontalLayout {
                padding-left: 14px;
                alignment: start;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    color: #77777c;
                    vertical-alignment: center;
                }
            }
        }
    }
}
