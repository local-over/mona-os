import { Button } from "std-widgets.slint";

component CalcButton inherits Rectangle {
    in property <string> text: "0";
    in property <color> base-color: #333336;
    in property <color> text-color: #ffffff;
    in property <bool> is-active-op: false;
    callback clicked();

    border-radius: self.height / 2;
    background: is-active-op ? #ffffff : touch.pressed ? base-color.darker(25%) : touch.has-hover ? base-color.brighter(15%) : base-color;
    animate background { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.is-active-op ? #ff9f0a : root.text-color;
        font-size: 20px;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component CalculatorWindow inherits Window {
    title: "Calculator";
    width: 250px;
    height: 340px;
    background: #1e1e20;
    default-font-family: "SF Pro Text, -apple-system, Helvetica Neue, sans-serif";

    in-out property <string> display-text: "0";
    in-out property <string> active-op: "";

    callback digit-clicked(string);
    callback op-clicked(string);
    callback equals-clicked();
    callback clear-clicked();
    callback sign-clicked();
    callback percent-clicked();
    callback decimal-clicked();
    callback close-window();
    callback minimize-window();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // --- 1. Authentic macOS Window Titlebar with Traffic Lights ---
        HorizontalLayout {
            height: 18px;
            alignment: start;
            spacing: 8px;

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #ff5f57;
                close-touch := TouchArea {
                    clicked => { root.close-window(); }
                }
            }

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #febc2e;
                min-touch := TouchArea {
                    clicked => { root.minimize-window(); }
                }
            }

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #28c840;
            }
        }

        // --- 2. Big Apple Digital LCD Display Area ---
        Rectangle {
            height: 60px;
            background: transparent;

            Text {
                text: root.display-text;
                color: #ffffff;
                font-size: 34px;
                font-weight: 300;
                horizontal-alignment: right;
                vertical-alignment: bottom;
                width: 100%;
                height: 100%;
            }
        }

        // --- 3. 4x5 Circular Apple Button Matrix ---
        // Row 0: AC, +/-, %, ÷
        HorizontalLayout {
            spacing: 10px;
            height: 42px;
            CalcButton { text: root.display-text == "0" ? "AC" : "C"; base-color: #a5a5a5; text-color: #000000; clicked => { root.clear-clicked(); } }
            CalcButton { text: "+/-"; base-color: #a5a5a5; text-color: #000000; clicked => { root.sign-clicked(); } }
            CalcButton { text: "%"; base-color: #a5a5a5; text-color: #000000; clicked => { root.percent-clicked(); } }
            CalcButton { text: "÷"; base-color: #ff9f0a; text-color: #ffffff; is-active-op: root.active-op == "÷"; clicked => { root.op-clicked("÷"); } }
        }

        // Row 1: 7, 8, 9, ×
        HorizontalLayout {
            spacing: 10px;
            height: 42px;
            CalcButton { text: "7"; clicked => { root.digit-clicked("7"); } }
            CalcButton { text: "8"; clicked => { root.digit-clicked("8"); } }
            CalcButton { text: "9"; clicked => { root.digit-clicked("9"); } }
            CalcButton { text: "×"; base-color: #ff9f0a; text-color: #ffffff; is-active-op: root.active-op == "×"; clicked => { root.op-clicked("×"); } }
        }

        // Row 2: 4, 5, 6, −
        HorizontalLayout {
            spacing: 10px;
            height: 42px;
            CalcButton { text: "4"; clicked => { root.digit-clicked("4"); } }
            CalcButton { text: "5"; clicked => { root.digit-clicked("5"); } }
            CalcButton { text: "6"; clicked => { root.digit-clicked("6"); } }
            CalcButton { text: "−"; base-color: #ff9f0a; text-color: #ffffff; is-active-op: root.active-op == "−"; clicked => { root.op-clicked("−"); } }
        }

        // Row 3: 1, 2, 3, +
        HorizontalLayout {
            spacing: 10px;
            height: 42px;
            CalcButton { text: "1"; clicked => { root.digit-clicked("1"); } }
            CalcButton { text: "2"; clicked => { root.digit-clicked("2"); } }
            CalcButton { text: "3"; clicked => { root.digit-clicked("3"); } }
            CalcButton { text: "+"; base-color: #ff9f0a; text-color: #ffffff; is-active-op: root.active-op == "+"; clicked => { root.op-clicked("+"); } }
        }

        // Row 4: 0 (Capsule), ., =
        HorizontalLayout {
            spacing: 10px;
            height: 42px;
            // 0 button (spans 2 columns)
            Rectangle {
                horizontal-stretch: 2;
                border-radius: self.height / 2;
                background: zero-touch.pressed ? #252528 : zero-touch.has-hover ? #404044 : #333336;
                animate background { duration: 120ms; easing: ease-out; }

                zero-touch := TouchArea {
                    clicked => { root.digit-clicked("0"); }
                }

                Text {
                    text: "0";
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 500;
                    vertical-alignment: center;
                    x: 20px;
                    y: (parent.height - self.height) / 2;
                }
            }

            CalcButton { horizontal-stretch: 1; text: "."; clicked => { root.decimal-clicked(); } }
            CalcButton { horizontal-stretch: 1; text: "="; base-color: #ff9f0a; text-color: #ffffff; clicked => { root.equals-clicked(); } }
        }
    }
}
